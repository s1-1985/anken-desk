<Project Sdk="Microsoft.NET.Sdk">

  <!-- 画面(WinForms)。net48 は Windows 10(1903以降)/11 に標準搭載済みで、会社PCに追加インストールが要らない。 -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>AnkenDesk.App</RootNamespace>
    <AssemblyName>AnkenDesk</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows標準のPDF描画エンジン(Windows.Data.Pdf)を net48 から使うための参照アセンブリ。
         参照のみで、ビルド出力にファイルは増えない（実体はWindows 10以降のOSに含まれる）。PDFsorterと同じ。 -->
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.26100.1742">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AnkenDesk.Core\AnkenDesk.Core.csproj" />
    <ProjectReference Include="..\AnkenDesk.OutlookAccess\AnkenDesk.OutlookAccess.csproj" />
  </ItemGroup>

</Project>
