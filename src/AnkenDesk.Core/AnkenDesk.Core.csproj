<Project Sdk="Microsoft.NET.Sdk">

  <!-- UI・COMに依存しない業務ロジック。netstandard2.0 なので、net48側(OutlookAccess, App)と
       net8.0(テスト)の両方から同じdllを参照できる。 -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>AnkenDesk.Core</RootNamespace>
    <AssemblyName>AnkenDesk.Core</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="System.Memory" Version="4.5.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- 見積依頼書のテンプレート（現行の「見積依頼」シート）。個人名・納場の名前は取り除いてある。 -->
    <EmbeddedResource Include="Resources\QuoteRequestTemplate.xlsx" LogicalName="AnkenDesk.Core.QuoteRequestTemplate.xlsx" />
  </ItemGroup>

</Project>
